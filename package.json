{
  "name": "vigil",
  "version": "0.1.0",
  "description": "vigil — dark operational component library. Civic utility x Public Works style guide, Svelte + Tailwind.",
  "keywords": [
    "svelte",
    "components",
    "design-system",
    "dark",
    "operational"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.ts"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/svelte": "^5.3.1",
    "@vitest/browser": "^4.1.2",
    "@vitest/browser-playwright": "^4.1.2",
    "autoprefixer": "^10.4.16",
    "chart.js": "^4.4.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^62.8.0",
    "eslint-plugin-svelte": "^3.16.0",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.58.2",
    "postcss": "^8.4.32",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "publint": "^0.3.18",
    "simple-git-hooks": "^2.13.1",
    "svelte": "^5.54.1",
    "svelte-check": "^4.4.5",
    "tailwindcss": "^3.4.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.2"
  },
  "type": "module",
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hammurabi-coder/vigil.git"
  },
  "bugs": {
    "url": "https://github.com/hammurabi-coder/vigil/issues"
  },
  "homepage": "https://github.com/hammurabi-coder/vigil#readme"
}
